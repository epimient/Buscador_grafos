# Copiar a apps/web/.env para desarrollo local.

# Dejar VACÍO en dev: así axios usa rutas relativas ("/api/...") que pasan por
# el proxy de Vite (vite.config.ts -> /api -> VITE_DEV_API_PROXY). Mismo origen,
# sin CORS, sin depender del puerto que acabe usando el dev server.
# En producción se usa apps/web/.env.production (VITE_API_URL=/vorael).
VITE_API_URL=

# Sub-ruta bajo la que se sirve el SPA. Alimenta tres cosas a la vez:
#   vite.config.ts -> base            (prefijo de los assets)
#   main.tsx       -> BrowserRouter basename
#   index.html     -> href del favicon (hardcodeado, ajustar si cambia)
VITE_BASE_PATH=/vorael/

# A dónde apunta el proxy de Vite en dev (el API Express local).
VITE_DEV_API_PROXY=http://localhost:3001
