# Producción: ruta relativa al mismo origen que sirve el SPA.
# axios pide "/vorael" + "/api/images" -> "/vorael/api/images", que Nginx
# proxea al backend Express (ver deploy/nginx-vorael.conf).
# Al ser mismo origen no hay CORS y el bundle no queda atado a un dominio.
VITE_API_URL=/vorael
VITE_BASE_PATH=/vorael/
