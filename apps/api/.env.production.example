# Copiar a /var/www/html/vorael/api/.env y rellenar los valores reales.
# Nunca subir este archivo con credenciales a un repositorio.

# PostgreSQL
DB_HOST=localhost
DB_PORT=9913
DB_NAME=generated_images
DB_USER=
DB_PASSWORD=
DB_SSL=false

# DigitalOcean Spaces (S3-compatible)
S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
S3_BUCKET=n8ns3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=sfo3

# Servidor
PORT=3001
# Detrás de Nginx: solo loopback, para no exponer el puerto 3001 a Internet.
HOST=127.0.0.1
# El front pide al mismo origen (/vorael/api/...) vía Nginx, así que el
# navegador nunca hace una petición cross-origin. Se deja el dominio como
# red de seguridad por si alguna vez se sirve el SPA desde otro host.
CORS_ORIGIN=https://n8n.americana.edu.co
