# Copiar a /var/www/html/vorael/api/.env y rellenar los valores reales.
# Nunca subir este archivo con credenciales a un repositorio.

# PostgreSQL
DB_HOST=localhost
DB_PORT=9913
DB_NAME=generated_images
DB_USER=
DB_PASSWORD=
DB_SSL=false

# DigitalOcean Spaces (S3-compatible)
S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
S3_BUCKET=n8ns3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=sfo3

# Servidor
PORT=3001
# Detrás de Nginx: solo loopback, para no exponer el puerto 3001 a Internet.
HOST=127.0.0.1
# El front pide al mismo origen (/vorael/api/...) vía Nginx, así que el
# navegador nunca hace una petición cross-origin. Se deja el dominio como
# red de seguridad por si alguna vez se sirve el SPA desde otro host.
CORS_ORIGIN=https://n8n.americana.edu.co

# Búsqueda semántica (requiere Ollama local + tabla image_embeddings)
# SEARCH_MODE: lexical | semantic | hybrid
SEARCH_MODE=hybrid
EMBED_MODEL=bge-m3
EMBED_SERVER=http://127.0.0.1:11434
# Debe coincidir con el modelo: bge-m3=1024, nomic-embed-text=768.
EMBED_DIM=1024
# Umbral mínimo de coseno del lado semántico; filtrar por debajo lo deja
# pasar ruido ("ventanilla", "sala de espera"). 0.65 medido en la query de
# prueba: 193 → 100 resultados, top-15 15/15 relevantes.
SEMANTIC_MIN_SCORE=0.65

# ExifTool (opcional): METADATA_EMBED=exiftool inyecta metadatos XMP-vorael
# en las descargas. Si falta el binario, degrada silenciosamente.
METADATA_EMBED=none
