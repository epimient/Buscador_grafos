# PostgreSQL
DB_HOST=<host-postgres>
DB_PORT=9913
DB_NAME=generated_images
DB_USER=
DB_PASSWORD=
DB_SSL=false

# DigitalOcean Spaces (S3-compatible)
S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
S3_BUCKET=n8ns3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=sfo3

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Graph engine
# SEARCH_ENGINE=graph        # default: in-memory Graphology (sql = fallback PostgreSQL)
# GRAPH_REFRESH_MS=60000     # intervalo del refresh incremental (delta con watermark)
# GRAPH_FULL_RELOAD_MS=600000  # cada cuánto se hace rebuild completo (reconcilia deletes)

# Semantic search (requires Ollama local + image_embeddings table)
# SEARCH_MODE=lexical        # lexical | semantic | hybrid (lexical = default)
# EMBED_MODEL=bge-m3         # modelo en Ollama (fallback recomendado: nomic-embed-text)
# EMBED_SERVER=http://127.0.0.1:11434
# EMBED_DIM=1024             # must match the model: bge-m3=1024, nomic-embed-text=768
