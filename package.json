{
  "name": "vorael",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de imágenes IA Americana — Envato-like",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "test": "pnpm --filter api test",
    "test:watch": "pnpm --filter api test:watch",
    "test:coverage": "pnpm --filter api test:coverage",
    "release": "bash deploy/build-release.sh",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20"
  }
}
